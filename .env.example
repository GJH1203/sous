# Copy to .env and fill in; .env is never committed. To load it into a shell:
#   set -a; . ./.env; set +a

# The cooking app's key for the gateway. The gateway reads it to recognise
# the app, and the app sends it. Any long random string will do:
#   openssl rand -hex 32
SOUS_APP_KEY=

# --- The cooking app ---

# Where the gateway listens. Default: http://127.0.0.1:8080
SOUS_GATEWAY_URL=http://127.0.0.1:8080

# The bot's token, from the Discord developer portal (Bot > Reset Token).
SOUS_DISCORD_TOKEN=

# The Discord user IDs the bot answers, separated by commas. It ignores
# everyone else. (Discord: Settings > Advanced > Developer Mode, then
# right-click a user > Copy User ID.)
SOUS_DISCORD_USERS=

# The time zone that "today" and "yesterday" mean, as an IANA name such as
# Europe/Berlin or America/Chicago.
SOUS_TIMEZONE=

# Where the database lives. Default: ~/.local/share/sous/sous.db
#SOUS_DB=
